<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../build/Native.targets" />

  <PropertyGroup>
    <!-- netstandard2.0 reaches .NET Framework 4.6.1 and everything after it,
         which is what a CAD plug-in host is likely to be. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>CadConvert</PackageId>
    <Version>0.3.0</Version>
    <Authors>omerbasavul</Authors>
    <Description>Parasolid (.x_t) and STEP (.stp) to glTF 2.0 or USDZ. Reads the B-Rep, tessellates it watertight, and writes a mesh with the materials the designer chose. No CAD kernel to install.</Description>
    <PackageTags>cad;parasolid;step;gltf;glb;usd;usdz;mesh;tessellation;brep</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <Copyright>Copyright (c) omerbasavul</Copyright>
    <PackageProjectUrl>https://github.com/omerbasavul/cadconvert</PackageProjectUrl>
    <RepositoryUrl>https://github.com/omerbasavul/cadconvert</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- A stack trace that names a line is worth having, and a build that
         gives the same bytes twice is worth more. Both are free here. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- The native library, one per runtime identifier.
       `PackagePath="runtimes"` is a directory, and pack appends each file's
       own `osx-arm64/native/` under it. Spelling that out as
       `runtimes/%(RecursiveDir)` doubles it, and the .NET host — which probes
       `runtimes/{rid}/native` — then finds nothing, silently, at the first
       P/Invoke. The first version of this glob pointed one directory too high
       and packed nothing at all, which fails the same silent way.
       A build machine has whichever runtime it can compile; the others come
       from the CI matrix and are dropped into the same tree before packing. -->
  <PropertyGroup>
    <NativeRuntimesDir>$(RuntimesRoot)</NativeRuntimesDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Named so the message below can count runtimes and not the readme. -->
    <CadConvertRuntime Include="$(NativeRuntimesDir)**/native/*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- NuGet runs a package's build/<id>.targets in the consumer's project.
         Ours is for the consumers whose host does not resolve runtimes/ on
         its own — see the file for which and why. -->
    <None Include="build/CadConvert.targets" Pack="true" PackagePath="build/" />
    <None Include="build/CadConvert.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- The C header, for a caller that is not .NET at all. The library it
         describes is the same one under runtimes/. -->
    <None Include="../../native/crates/cad-ffi/include/cadconvert.h"
          Pack="true" PackagePath="build/native/include/" />
    <None Include="$(NativeRuntimesDir)**/native/*"
          Pack="true"
          PackagePath="runtimes"
          Visible="false" />
  </ItemGroup>

  <Target Name="SayWhichRuntimesArePacked" BeforeTargets="Pack">
    <Message Importance="high"
             Text="cadconvert native runtimes packed: @(CadConvertRuntime->'%(RecursiveDir)', ' ')" />
    <Warning Condition="'@(CadConvertRuntime)' == ''"
             Text="No native cadconvert library found under $(NativeRuntimesDir). The package will build and every call will fail at load time." />
  </Target>

</Project>
