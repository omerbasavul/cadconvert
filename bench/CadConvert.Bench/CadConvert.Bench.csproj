<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the library first (via the project reference below) and puts it
       beside this project's output, so the P/Invoke resolves. -->
  <Import Project="$(MSBuildThisFileDirectory)../../build/NativeConsumer.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>bench</AssemblyName>
    <RootNamespace>CadConvert.Bench</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CadConvert/CadConvert.csproj" />
  </ItemGroup>

</Project>
