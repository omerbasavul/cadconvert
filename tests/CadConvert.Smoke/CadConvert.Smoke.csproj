<Project Sdk="Microsoft.NET.Sdk">

  <!-- Only where the library is, not how to build it: the project reference
       below makes the library project build and stage it first. -->
  <Import Project="$(MSBuildThisFileDirectory)../../build/Native.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>smoke</AssemblyName>
    <RootNamespace>CadConvert.Smoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CadConvert/CadConvert.csproj" />
    <!-- A project reference does not carry a NuGet package's runtimes/ layout,
         so this machine's own native library is put beside the executable. The
         package itself ships every runtime under runtimes/{rid}/native, which
         is what the .NET host probes. -->
    <None Include="$(NativeLibraryStaged)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('$(NativeLibraryStaged)')" />
  </ItemGroup>
</Project>
